rules_version = '2';
// Cápsula do tempo: arquivos podem ser lidos por quem tem o link e enviados
// uma vez só. Ninguém troca nem apaga foto ou áudio depois de enviado.
service firebase.storage {
  match /b/{bucket}/o {
    match /capsulas/{capsulaId}/{arquivo} {
      allow read: if true;
      allow create: if request.resource.size < 10 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*')
                        || request.resource.contentType.matches('audio/.*'));
      allow update, delete: if false;
    }
    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
